import "std/testing"
import "std/text"

# `when_failed` hands back the bare reason, so this names a reason type and
# never an err — json cannot rescue what json raised.
test_decode_array = same? (decode "[1, 2, 3]") [1 2 3]

test_decode_bool = decode "true"

test_decode_escapes = same? (decode "\"a\\n\\\"b\\\"\"") "a\n\"b\""

test_decode_float = same? (decode "3.25") 3.25

test_decode_int = same? (decode "42") 42

test_decode_nested =
  decoded = decode "\{\"a\": [1, \{\"b\": null}]}"
  same? decoded { "a":[1 { "b":json_null }] }

test_decode_object = same? (decode "\{\"a\": 1, \"b\": 2}") { "a":1 "b":2 }

test_decode_string = same? (decode "\"hello\"") "hello"

test_decode_surrogate_pair = same? (decode "\"\\ud83c\\udf8c\"") "🎌"

test_decode_unicode = same? (decode "\"\\u00e9\"") "é"

test_decode_whitespace = same? (decode "  [ 1 , 2 ]  ") [1 2]

test_encode_empty_list = encode [] == "[]"

test_encode_empty_map = encode {} == "\{}"

test_encode_escapes = encode "a\"b\nc" == "\"a\\\"b\\nc\""

test_encode_shorthands =
  raw = text/utf8 [120 8 121 12 122]
  encode raw == "\"x\\by\\fz\""

test_encode_nested =
  value = { "a":true "b":[1 2] }
  encode value == "\{\"a\":true,\"b\":[1,2]}"

test_error_position =
  decoded = decode "[1, nope]"
  testing/when_failed decoded (r -> r.position == 5)

test_error_trailing =
  decoded = decode "1 x"
  testing/when_failed decoded (r -> r.position == 3)

test_roundtrip =
  text = "\{\"a\":[1,2.5,\"x\"],\"b\":null}"
  re_encoded? (decode text) text

# `decode` answers a value or an err, and an err where a value is wanted is
# refused at check. These two dispatch on it once each, so a decode that
# failed reads as a failed test rather than as a comparison nobody can make.
fn re_encoded? (err _) _
  false

fn re_encoded? v want
  encode v == want

fn same? (err _) _
  false

fn same? got want
  got == want
